# 로컬에서 돌릴 때만 쓴다. 이 파일을 .env로 복사해 값을 채우고, .env는 커밋하지 않는다.
# 로컬 실행은 늘 노션에 쓰지 않는 모드(미리보기)다. 노션 토큰은 읽기 연결의 것만 둔다.

# 노션 읽기 연결의 Installation access token
NOTION_TOKEN=
# 노션 `대회목록`의 데이터 소스 ID
NOTION_DATA_SOURCE_ID=
# 이 도구 전용 OpenAI 프로젝트의 API 키
OPENAI_API_KEY=
# Kaggle API 토큰. 없으면 Kaggle만 설정 누락으로 건너뛴다
KAGGLE_API_TOKEN=
# 판별 모델 이름. 비우면 batch/settings.toml의 기본값
OPENAI_MODEL=
